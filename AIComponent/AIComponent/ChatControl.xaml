<UserControl
    x:Class="AIComponent.ChatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AduAttach="clr-namespace:AduSkin.AdditionalAttributes;assembly=AduSkin"
    xmlns:AduSkin="https://github.com/aduskin"
    xmlns:behavior="clr-namespace:AIComponent.Behaviors"
    xmlns:controls="clr-namespace:AIComponent.Controls"
    x:Name="Root"
    MinWidth="320"
    MinHeight="340"
    FontFamily="Microsoft YaHei UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style
                x:Key="NoAvatarBubble"
                BasedOn="{StaticResource AduChatBubble}"
                TargetType="AduSkin:AduChatBubble">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AduSkin:AduChatBubble">
                            <Border
                                x:Name="Bubble"
                                MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="6"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource NormalBorderBrush}"
                                CornerRadius="2,12,12,12">
                                <Grid>
                                    <controls:StreamingMarkdownViewer
                                        x:Name="MarkdownReply"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Style="{StaticResource AduMarkDownViewer}"
                                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <AduSkin:AduTextBox
                                        x:Name="PlainMessage"
                                        Height="Auto"
                                        Padding="2"
                                        AduAttach:BackgroundAttach.MouseOverBackground="Transparent"
                                        AcceptsReturn="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        MultipleLine="True"
                                        Text="{TemplateBinding Text}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ReceptionType" Value="Sender">
                                    <Setter TargetName="MarkdownReply" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PlainMessage" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Bubble" Property="CornerRadius" Value="12,2,12,12" />
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="20,0,0,0" />
                                </Trigger>
                                <Trigger Property="ReceptionType" Value="Receiver">
                                    <Setter TargetName="Bubble" Property="Margin" Value="0,0,20,0" />
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid DataContext="{Binding ViewModel, ElementName=Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="10,0">
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="AI 助手" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <AduSkin:AduPathIconButton
                    x:Name="ClearButton"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{Binding NewChatCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    PathDataAttach.PathData="{DynamicResource Icon_Clear}"
                    PathDataAttach.Width="12"
                    ToolTip="清空当前 AI 对话" />
                <AduSkin:AduPathIconButton
                    x:Name="SettingsButton"
                    Grid.Column="3"
                    Width="Auto"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Command="{Binding ToggleSettingsCommand}"
                    FontSize="22"
                    Foreground="{DynamicResource PrimaryBrush}"
                    PathDataAttach.PathData="{DynamicResource Icon_Setting}"
                    ToolTip="切换设置 / 对话" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid x:Name="ChatPage" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToReVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" Margin="0,6">
                    <TextBlock
                        x:Name="Welcome"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="#999999"
                        Text="有什么可以帮你？&#xA;&#xA;选择已配置的 AI 开始对话&#xA;点击右上角设置添加模型服务"
                        TextAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
                    <AduScrollViewer
                        x:Name="MessagesScroller"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollChanged="FollowStreamingReply"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Messages" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <AduSkin:AduChatBubble
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        ReceptionType="{Binding ReceptionType}"
                                        Style="{StaticResource NoAvatarBubble}"
                                        Text="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </AduScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Margin="6,0,6,4">
                    <StackPanel Orientation="Horizontal">
                        <AduSkin:AduButton
                            x:Name="AttachFilesButton"
                            Width="Auto"
                            Padding="10,0"
                            Click="SelectTextFiles"
                            Content="添加文件"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip="选择 TXT 或 Markdown 文件；发送时将正文提供给当前模型" />
                        <AduSkin:AduButton
                            x:Name="AttachDirectoryButton"
                            Width="Auto"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Click="SelectDirectory"
                            Content="添加目录"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip="递归读取文本和代码文件，跳过目录链接；最多 128 个文件、单文件 256 KiB、合计 2 MiB" />
                    </StackPanel>
                    <AduScrollViewer
                        MaxHeight="110"
                        Margin="4,4,4,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasAttachments, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplayName}" />
                                        <AduSkin:AduPathIconButton
                                            Grid.Column="1"
                                            Width="28"
                                            Height="24"
                                            Click="RemoveTextAttachment"
                                            IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            PathDataAttach.PathData="{DynamicResource Icon_SystemClose}"
                                            PathDataAttach.Width="8"
                                            ToolTip="移除此附件" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </AduScrollViewer>
                </StackPanel>
                <Grid Grid.Row="3" Margin="6,0,6,6">
                    <AduSkin:AduTextBox
                        x:Name="Input"
                        MinHeight="100"
                        MaxHeight="200"
                        Padding="6,8,6,30"
                        VerticalContentAlignment="Top"
                        AduAttach:InputAttach.InputHint="与 AI 对话…"
                        behavior:ChatViewBehavior.EnterCommand="{Binding SendCommand}"
                        AcceptsReturn="True"
                        BackgroundAttach.MouseOverBackground="Transparent"
                        BorderAttach.CornerRadius="10"
                        MultipleLine="True"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        ToolTip="Enter 发送，Shift+Enter 换行"
                        VerticalScrollBarVisibility="Auto" />
                    <Grid Margin="10,4" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="Status"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Text="{Binding Status}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Status}" />

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <AduSkin:AduComboBox
                                x:Name="AiSelector"
                                MaxWidth="230"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                BorderThickness="0"
                                DisplayMemberPath="Name"
                                IsEnabled="{Binding IsIdle}"
                                IsShowFilterBox="True"
                                ItemsSource="{Binding Profiles}"
                                SelectedItem="{Binding SelectedAi, Mode=TwoWay}"
                                ToolTip="选择 AI" />
                            <AduPathIconButton
                                x:Name="SendButton"
                                Width="26"
                                Height="26"
                                AduAttach:BackgroundAttach.MouseOverBackground="{DynamicResource NormalForeground}"
                                AduAttach:BackgroundAttach.PressedBackground="{DynamicResource NormalForeground}"
                                AduAttach:BorderAttach.CornerRadius="15"
                                AduAttach:PathBrushAttach.MouseOverPathBrush="{DynamicResource NormalBackground}"
                                AduAttach:PathBrushAttach.NormalPathBrush="{DynamicResource NormalBackground}"
                                AduAttach:PathBrushAttach.PressedPathBrush="{DynamicResource NormalBackground}"
                                AduAttach:PathDataAttach.Width="10"
                                Background="{DynamicResource NormalForeground}"
                                Command="{Binding SendOrStopCommand}"
                                Content=""
                                PathDataAttach.Margin="0"
                                ToolTip="{Binding SendToolTip}">
                                <AduSkin:AduPathIconButton.Style>
                                    <Style BasedOn="{StaticResource AduPathIconButton}" TargetType="AduSkin:AduPathIconButton">
                                        <Setter Property="AduAttach:PathDataAttach.PathData" Value="{DynamicResource Icon_UpArrow1}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="AduAttach:PathDataAttach.PathData" Value="M 0,0 L 10,0 10,10 0,10 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </AduSkin:AduPathIconButton.Style>
                            </AduPathIconButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Border x:Name="SettingsPage" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
                <AduSkin:AduScrollViewer
                    Padding="10,4"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Text="已保存的 AI" />
                        <AduSkin:AduComboBox
                            x:Name="ProfileSelector"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding IsIdle}"
                            IsShowFilterBox="True"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding EditingProfile, Mode=TwoWay}" />
                        <StackPanel Margin="0,8,0,14" Orientation="Horizontal">
                            <AduSkin:AduButton
                                Width="Auto"
                                Padding="10,0"
                                Command="{Binding AddProfileCommand}"
                                Content="添加 AI" />
                            <AduSkin:AduButton
                                Width="Auto"
                                Margin="8,0,0,0"
                                Padding="10,0"
                                Command="{Binding DeleteProfileCommand}"
                                Content="删除配置" />
                        </StackPanel>
                        <TextBlock Margin="0,0,0,6" Text="API 类型" />
                        <AduSkin:AduComboBox
                            x:Name="ProviderSelector"
                            DisplayMemberPath="Name"
                            IsEditable="False"
                            IsShowFilterBox="True"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding Providers}"
                            MaxDropDownHeight="280"
                            SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />
                        <TextBlock Margin="0,14,0,6" Text="显示名称" />
                        <AduSkin:AduTextBox x:Name="ProfileName" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,6" Text="API 基础地址" />
                        <AduSkin:AduTextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,6" Text="模型 ID" />
                        <AduSkin:AduTextBox x:Name="Model" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,6" Text="API 密钥" />
                        <AduSkin:AduPasswordBox
                            x:Name="ApiKey"
                            BorderBrush="#DDDDDD"
                            IsCanSeePassword="True"
                            Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <AduSkin:AduCheckBox
                            x:Name="EnableTools"
                            Margin="0,14"
                            Content="启用宿主工具调用（需要模型支持）"
                            IsChecked="{Binding EnableTools, Mode=TwoWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#999999"
                            Text="模型 ID 以服务商实际可用模型为准；Ollama 可不填密钥。配置切换保留各 AI 当前会话。"
                            TextWrapping="Wrap" />
                        <AduSkin:AduButton
                            Width="Auto"
                            Margin="0,8"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource PrimaryBrush}"
                            Command="{Binding SaveProfileCommand}"
                            Content="保存并使用"
                            Foreground="White" />
                        <TextBlock
                            x:Name="SettingsStatus"
                            Foreground="#C65B52"
                            Text="{Binding SettingsStatus}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </AduSkin:AduScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
