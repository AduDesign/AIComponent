<UserControl x:Class="AIComponent.ChatControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:AduAttach="clr-namespace:AduSkin.AdditionalAttributes;assembly=AduSkin" xmlns:AduSkin="https://github.com/aduskin" MinWidth="320" MinHeight="340" FontFamily="Microsoft YaHei UI" x:Name="Root" xmlns:behavior="clr-namespace:AIComponent.Behaviors">
  <UserControl.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolVisibility" />
      <Style x:Key="NoAvatarBubble" BasedOn="{StaticResource AduChatBubble}" TargetType="AduSkin:AduChatBubble">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="AduSkin:AduChatBubble">
              <Border x:Name="Bubble" MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="6" HorizontalAlignment="Left" Background="{DynamicResource NormalBorderBrush}" CornerRadius="2,12,12,12">
                <AduSkin:AduTextBox Height="Auto" Padding="2" AduAttach:BackgroundAttach.MouseOverBackground="Transparent" Background="Transparent" BorderThickness="0" IsReadOnly="True" MultipleLine="True" Text="{TemplateBinding Text}" TextWrapping="Wrap" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ReceptionType" Value="Sender">
                  <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                  <Setter TargetName="Bubble" Property="CornerRadius" Value="12,2,12,12" />
                  <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid DataContext="{Binding ViewModel, ElementName=Root}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="AI 助手" />
      <AduSkin:AduPathIconButton x:Name="ClearButton" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" BorderThickness="0" Foreground="{DynamicResource PrimaryBrush}" PathDataAttach.PathData="{DynamicResource Icon_Clear}" PathDataAttach.Width="10" ToolTip="清空当前 AI 对话" Command="{Binding NewChatCommand}" />
      <AduSkin:AduPathIconButton x:Name="SettingsButton" Grid.Column="3" Width="Auto" VerticalAlignment="Center" Background="Transparent" FontSize="22" Foreground="{DynamicResource PrimaryBrush}" PathDataAttach.PathData="{DynamicResource Icon_Setting}" ToolTip="切换设置 / 对话" Command="{Binding ToggleSettingsCommand}" />
    </Grid>
    <Grid Grid.Row="1">
      <Grid x:Name="ChatPage" Visibility="{Binding IsChatOpen, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
          <TextBlock x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#999999" Text="有什么可以帮你？&#xA;&#xA;选择已配置的 AI 开始对话&#xA;点击右上角设置添加模型服务" TextAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
          <AduSkin:AduListBox x:Name="Messages" HorizontalContentAlignment="Stretch" AduAttach:PlaceHolderAttach.PlaceHolderVisible="Collapsed" Background="Transparent" BorderAttach.CornerRadius="0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AduSkin:ListBoxExtend.ScrollPositionType="End" ItemsSource="{Binding Messages}">
            <AduSkin:AduListBox.Resources>
              <Style BasedOn="{StaticResource AduListBoxItem}" TargetType="AduSkin:AduListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="AduAttach:BackgroundAttach.MouseOverBackground" Value="Transparent" />
                <Setter Property="AduAttach:BackgroundAttach.SelectedBackground" Value="Transparent" />
              </Style>
            </AduSkin:AduListBox.Resources>
            <AduSkin:AduListBox.ItemTemplate>
 <DataTemplate>
  <AduSkin:AduChatBubble Style="{StaticResource NoAvatarBubble}" Text="{Binding Text}" ReceptionType="{Binding ReceptionType}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type AduSkin:AduListBox}}}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
 </DataTemplate>
</AduSkin:AduListBox.ItemTemplate>
          </AduSkin:AduListBox>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,10" Foreground="#888888" TextWrapping="Wrap" Text="{Binding Status}" />
        <Grid Grid.Row="3">
          <AduSkin:AduTextBox x:Name="Input" MinHeight="100" MaxHeight="200" Padding="6,8,6,30" VerticalContentAlignment="Top" AduAttach:InputAttach.InputHint="与 AI 对话…" AcceptsReturn="True" BackgroundAttach.MouseOverBackground="Transparent" BorderAttach.CornerRadius="10" MultipleLine="True" TextWrapping="Wrap" ToolTip="Enter 发送，Shift+Enter 换行" VerticalScrollBarVisibility="Auto" behavior:ChatViewBehavior.EnterCommand="{Binding SendCommand}" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
          <StackPanel Margin="10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <AduSkin:AduComboBox x:Name="AiSelector" MaxWidth="230" Margin="0,0,10,0" HorizontalAlignment="Right" BorderThickness="0" DisplayMemberPath="Name" IsShowFilterBox="True" ToolTip="选择 AI" IsEnabled="{Binding IsIdle}" SelectedItem="{Binding SelectedAi, Mode=TwoWay}" ItemsSource="{Binding Profiles}" />
            <AduPathIconButton x:Name="SendButton" Width="28" Height="28" AduAttach:BackgroundAttach.MouseOverBackground="{DynamicResource NormalForeground}" AduAttach:BackgroundAttach.PressedBackground="{DynamicResource NormalForeground}" AduAttach:BorderAttach.CornerRadius="15" AduAttach:PathBrushAttach.MouseOverPathBrush="{DynamicResource NormalBackground}" AduAttach:PathBrushAttach.NormalPathBrush="{DynamicResource NormalBackground}" AduAttach:PathBrushAttach.PressedPathBrush="{DynamicResource NormalBackground}" AduAttach:PathDataAttach.Width="10" Background="{DynamicResource NormalForeground}" Command="{Binding SendOrStopCommand}" Content="" PathDataAttach.Margin="0" ToolTip="{Binding SendToolTip}">
              <AduSkin:AduPathIconButton.Style>
 <Style TargetType="AduSkin:AduPathIconButton" BasedOn="{StaticResource AduPathIconButton}">
  <Setter Property="AduAttach:PathDataAttach.PathData" Value="{DynamicResource Icon_UpArrow1}" />
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsBusy}" Value="True">
    <Setter Property="AduAttach:PathDataAttach.PathData" Value="M 0,0 L 10,0 10,10 0,10 Z" />
   </DataTrigger>
  </Style.Triggers>
 </Style>
</AduSkin:AduPathIconButton.Style>
            </AduPathIconButton>
          </StackPanel>
        </Grid>
      </Grid>
      <Border x:Name="SettingsPage" Padding="22,12" Background="White" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}">
        <AduSkin:AduScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Margin="0,4,0,20" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold" Text="AI 设置" />
            <TextBlock Margin="0,0,0,6" Text="已保存的 AI" />
            <AduSkin:AduComboBox x:Name="ProfileSelector" DisplayMemberPath="Name" IsShowFilterBox="True" IsEnabled="{Binding IsIdle}" SelectedItem="{Binding EditingProfile, Mode=TwoWay}" ItemsSource="{Binding Profiles}" />
            <StackPanel Margin="0,8,0,14" Orientation="Horizontal">
              <AduSkin:AduButton Width="Auto" Padding="10,0" Content="添加 AI" Command="{Binding AddProfileCommand}" />
              <AduSkin:AduButton Width="Auto" Margin="8,0,0,0" Padding="10,0" Content="删除配置" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
            <TextBlock Margin="0,0,0,6" Text="API 类型" />
            <AduSkin:AduComboBox x:Name="ProviderSelector" DisplayMemberPath="Name" IsEditable="False" IsShowFilterBox="True" IsTextSearchEnabled="True" MaxDropDownHeight="280" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" ItemsSource="{Binding Providers}" />
            <TextBlock Margin="0,14,0,6" Text="显示名称" />
            <AduSkin:AduTextBox x:Name="ProfileName" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,6" Text="API 基础地址" />
            <AduSkin:AduTextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,6" Text="模型 ID" />
            <AduSkin:AduTextBox x:Name="Model" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,6" Text="API 密钥" />
            <AduSkin:AduPasswordBox x:Name="ApiKey" BorderBrush="#DDDDDD" IsCanSeePassword="True" Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <AduSkin:AduCheckBox x:Name="EnableTools" Margin="0,14" Content="启用宿主工具调用（需要模型支持）" IsChecked="{Binding EnableTools, Mode=TwoWay}" />
            <TextBlock FontSize="12" Foreground="#999999" Text="模型 ID 以服务商实际可用模型为准；Ollama 可不填密钥。配置切换保留各 AI 当前会话。" TextWrapping="Wrap" />
            <AduSkin:AduButton Width="Auto" Margin="0,10" HorizontalAlignment="Stretch" Background="{DynamicResource PrimaryBrush}" Content="保存并使用此 AI" Foreground="White" Command="{Binding SaveProfileCommand}" />
            <TextBlock x:Name="SettingsStatus" Margin="0,4,0,12" Foreground="#C65B52" TextWrapping="Wrap" Text="{Binding SettingsStatus}" />
          </StackPanel>
        </AduSkin:AduScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
