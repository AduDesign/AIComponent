<UserControl
    x:Class="AIComponent.ChatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AduAttach="clr-namespace:AduSkin.AdditionalAttributes;assembly=AduSkin"
    xmlns:AduSkin="https://github.com/aduskin"
    MinWidth="320"
    MinHeight="340"
    FontFamily="Microsoft YaHei UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style
                x:Key="NoAvatarBubble"
                BasedOn="{StaticResource AduChatBubble}"
                TargetType="AduSkin:AduChatBubble">
                <Setter Property="Margin" Value="0,7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AduSkin:AduChatBubble">
                            <Border
                                x:Name="Bubble"
                                MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource NormalBorderBrush}"
                                CornerRadius="2,12,12,12">
                                <AduSkin:AduTextBox
                                    Padding="2"
                                    AduAttach:BackgroundAttach.MouseOverBackground="Transparent"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    IsReadOnly="True"
                                    MultipleLine="True"
                                    Text="{TemplateBinding Text}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ReceptionType" Value="Sender">
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Bubble" Property="CornerRadius" Value="12,2,12,12" />
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Background="White"
        BorderBrush="#DDDDDD"
        BorderThickness="1"
        CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border
                Padding="18,0"
                BorderBrush="#E8E8E8"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        Foreground="{StaticResource Accent}"
                        Text="✧" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="AI 助手" />
                    <AduSkin:AduButton
                        x:Name="ClearButton"
                        Grid.Column="2"
                        Height="38"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Click="NewChat"
                        Content="⌫"
                        Foreground="{StaticResource Accent}"
                        ToolTip="清空当前 AI 对话" />
                    <AduSkin:AduButton
                        x:Name="SettingsButton"
                        Grid.Column="3"
                        Height="38"
                        VerticalAlignment="Center"
                        Click="ToggleSettings"
                        Content="⚙"
                        FontSize="22"
                        Foreground="{StaticResource Accent}"
                        ToolTip="切换设置 / 对话" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid x:Name="ChatPage" Margin="18,12,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="Welcome"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="#999999"
                            Text="有什么可以帮你？&#10;&#10;选择已配置的 AI 开始对话&#10;点击右上角设置添加模型服务"
                            TextAlignment="Center" />
                        <AduSkin:AduListBox
                            x:Name="Messages"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <AduSkin:AduListBox.Resources>
                                <Style BasedOn="{StaticResource AduListBoxItem}" TargetType="AduSkin:AduListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="AduAttach:BackgroundAttach.MouseOverBackground" Value="Transparent" />
                                    <Setter Property="AduAttach:BackgroundAttach.SelectedBackground" Value="Transparent" />
                                </Style>
                            </AduSkin:AduListBox.Resources>
                        </AduSkin:AduListBox>
                    </Grid>
                    <TextBlock
                        x:Name="Status"
                        Grid.Row="2"
                        Margin="0,10"
                        Foreground="#888888"
                        TextWrapping="Wrap" />
                    <Border
                        Grid.Row="3"
                        Padding="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <AduSkin:AduTextBox
                                x:Name="Input"
                                MinHeight="55"
                                MaxHeight="140"
                                AduAttach:InputAttach.InputHint="与 AI 对话…"
                                AcceptsReturn="True"
                                BorderThickness="0"
                                MultipleLine="True"
                                PreviewKeyDown="InputKeyDown"
                                TextWrapping="Wrap"
                                ToolTip="Enter 发送，Shift+Enter 换行"
                                VerticalScrollBarVisibility="Auto" />
                            <DockPanel Grid.Row="1" Margin="0,5,0,0">
                                <AduSkin:AduButton
                                    x:Name="SendButton"
                                    Width="36"
                                    Height="36"
                                    AduAttach:BorderAttach.CornerRadius="18"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Click="SendClick"
                                    Content="↑"
                                    DockPanel.Dock="Right"
                                    FontSize="22"
                                    Foreground="White"
                                    ToolTip="发送消息" />
                                <AduSkin:AduComboBox
                                    x:Name="AiSelector"
                                    MinWidth="140"
                                    MaxWidth="230"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="SelectAi"
                                    ToolTip="选择 AI" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Border
                    x:Name="SettingsPage"
                    Padding="22,12"
                    Background="White"
                    Visibility="Collapsed">
                    <AduSkin:AduScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="0,4,0,20"
                                HorizontalAlignment="Center"
                                FontSize="25"
                                FontWeight="Bold"
                                Text="AI 设置" />
                            <TextBlock Margin="0,0,0,6" Text="已保存的 AI" />
                            <AduSkin:AduComboBox
                                x:Name="ProfileSelector"
                                DisplayMemberPath="Name"
                                SelectionChanged="EditProfile" />
                            <StackPanel Margin="0,8,0,14" Orientation="Horizontal">
                                <AduSkin:AduButton Click="AddProfile" Content="+ 添加 AI" />
                                <AduSkin:AduButton
                                    Margin="8,0,0,0"
                                    Click="DeleteProfile"
                                    Content="删除配置" />
                            </StackPanel>
                            <TextBlock Margin="0,0,0,6" Text="API 类型" />
                            <AduSkin:AduComboBox
                                x:Name="ProviderSelector"
                                DisplayMemberPath="Name"
                                IsEditable="False"
                                IsShowFilterBox="True"
                                IsTextSearchEnabled="True"
                                MaxDropDownHeight="280"
                                SelectionChanged="PresetChanged" />
                            <TextBlock Margin="0,14,0,6" Text="显示名称" />
                            <AduSkin:AduTextBox x:Name="ProfileName" />
                            <TextBlock Margin="0,14,0,6" Text="API 基础地址" />
                            <AduSkin:AduTextBox x:Name="Endpoint" />
                            <TextBlock Margin="0,14,0,6" Text="模型 ID" />
                            <AduSkin:AduTextBox x:Name="Model" />
                            <TextBlock Margin="0,14,0,6" Text="API 密钥" />
                            <AduSkin:AduPasswordBox
                                x:Name="ApiKey"
                                Padding="10,9"
                                BorderBrush="#DDDDDD"
                                FontSize="14"
                                IsCanSeePassword="True" />
                            <AduSkin:AduCheckBox
                                x:Name="EnableTools"
                                Margin="0,14"
                                Content="启用宿主工具调用（需要模型支持）"
                                IsChecked="True" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#999999"
                                Text="模型 ID 以服务商实际可用模型为准；Ollama 可不填密钥。配置切换保留各 AI 当前会话。"
                                TextWrapping="Wrap" />
                            <AduSkin:AduButton
                                Width="Auto"
                                Margin="0,10"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource PrimaryBrush}"
                                Click="SaveProfile"
                                Content="保存并使用此 AI"
                                Foreground="White" />
                            <TextBlock
                                x:Name="SettingsStatus"
                                Margin="0,4,0,12"
                                Foreground="#C65B52"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </AduSkin:AduScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>





