<Window
    x:Class="AIComponent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ai="clr-namespace:AIComponent;assembly=AIComponent"
    Title="AI 助手组件示例"
    Width="580"
    Height="820"
    MinWidth="390"
    MinHeight="560"
    Background="#EEF0F2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ai:ChatControl x:Name="Chat" />
        <TextBlock
            x:Name="PlayerStatus"
            Grid.Row="1"
            Margin="8,10,0,0"
            Foreground="#777777"
            Text="宿主模拟播放器：未播放" />
    </Grid>
</Window>
